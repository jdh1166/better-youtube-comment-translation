{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.3.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/bg/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/i18n.js",
        "src/core/util.js",
        "src/core/settings.js",
        "src/core/langdetect.js",
        "src/core/cache.js",
        "src/core/queue.js",
        "src/core/engine-builtin.js",
        "src/content/ytdom.js",
        "src/content/ui.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Better YouTube Comment Translation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-auto-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_cmdToggleAuto__"
    },
    "translate-all-now": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdTranslateAll__"
    }
  },
  "default_locale": "en"
}
